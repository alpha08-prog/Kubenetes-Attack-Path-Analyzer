# ── Frontend environment (Vite) ───────────────────────────────────────────────
# Copy to .env.local for local dev, or set these as build-time env vars in CI / Render.
# NOTE: Vite bakes VITE_* vars into the bundle at BUILD time, so they must be set
# before `npm run build` — changing them later requires a rebuild.

# Base URL of the backend API.
#   - Local dev (Vite + local backend):     http://127.0.0.1:8000
#   - Docker compose (served by nginx):     leave unset / http://localhost:8000
#   - Render (static site → public backend): https://<your-backend>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Offline mock fallback. When the backend is unreachable the UI falls back to a
# synthetic Nokia-telecom scenario and shows a banner. Set to `off` to disable the
# fallback entirely and surface real backend errors instead.
# VITE_API_MOCK=off
