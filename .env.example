# ── Attack Path Analyzer — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI Narration (Gemini) ─────────────────────────────────────────────────────
# Free API key from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Narration (Groq) ───────────────────────────────────────────────────────
# Free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Slack Alerts ──────────────────────────────────────────────────────────────
# Incoming Webhook URL from: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── NVD CVE Lookups (optional) ────────────────────────────────────────────────
# Optional API key from: https://nvd.nist.gov/developers (raises rate limit)
NVD_API_KEY=

# ── App Config ────────────────────────────────────────────────────────────────
# true  = load nokia_telecom.json (safe for demo day)
# false = fetch live data from kubectl / minikube
MOCK_MODE=true
MOCK_SCENARIO=data/scenarios/nokia_telecom.json

CLUSTER_NAME=nokia-telecom-cluster

# Set to true for verbose logs during development
DEBUG=false
